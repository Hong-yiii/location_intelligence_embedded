@startuml
title Current UWB Multi-Session Implementation Architecture
allowmixing

' Style and theme
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam monochrome true
skinparam shadowing false

' Components
package "Application Layer" {
    component "Main Task" as MT
    component "Session Manager" as SM
    component "Resource Manager" as RM
    
    package "Device Adapters" {
        component "iPhone Adapter" as IA
        component "Board Adapter" as BA
        component "BLE App" as BLEAPP
    }
    
    package "Discovery" {
        component "Discovery Manager" as DM
    }
}

package "Middleware Layer" {
    component "UWB Core API" as UWBAPI
    component "BLE Stack" as BLE
    component "OSAL" as OSAL
    component "TLV Builder" as TLV
}

package "Hardware Abstraction Layer" {
    component "UWB HAL" as UWBHAL
    component "BLE HAL" as BLEHAL
    component "Board HAL" as BOARDHAL
}

' Class definitions
class MainTask {
    -appState: AppState
    +MultiSessionTask(): void
    +MultiSessionAppCallback(): void
    -initializeApplication(): bool
    -printApplicationStatus(): void
}

class SessionManager {
    -sessions: SessionContext[MAX_SESSIONS]
    -activeSessions: uint8_t
    -rangingMutex: OSAL_MUTEX
    +Init(): bool
    +CreateSession(deviceType: DeviceType): int
    +StartSession(sessionIndex: int): bool
    +HandleRangingData(sessionIndex: int): void
}

class ResourceManager {
    -channels: ChannelAllocation[MAX_CHANNELS]
    -timeSlots: TimeSlot[MAX_TIME_SLOTS]
    -isInitialized: bool
    +AllocateChannel(sessionIndex: int): uint8_t
    +AllocateTimeSlot(sessionIndex: int): bool
    +OptimizeResourceAllocation(): void
}

class BoardAdapter {
    -discoveryActive: bool
    -discoveredBoards: uint8_t
    +Init(): bool
    +StartDiscovery(maxBoards: uint8_t): bool
    +ProcessDiscoveryEvents(): void
}

class iPhoneAdapter {
    -sessionContext: iPhoneSessionContext
    -bleParams: BleParams
    +Init(): bool
    +HandleConnection(): void
    +ProcessRangingData(): void
}

' Relationships
MT --> SM : manages
MT --> RM : manages
MT --> BA : controls
MT --> IA : controls
MT --> BLEAPP : initializes

SM --> RM : allocates resources
SM --> UWBAPI : initializes sessions

BA --> DM : uses
BA --> SM : creates sessions
IA --> SM : creates sessions

BLEAPP --> BLE : configures
IA --> BLE : uses
BA --> UWBAPI : uses
IA --> UWBAPI : uses

DM --> UWBAPI : monitors

' Dependencies
MainTask --> SessionManager
MainTask --> ResourceManager
SessionManager --> ResourceManager
BoardAdapter --> DiscoveryManager
iPhoneAdapter --> TLV

@enduml
