@startuml "UWB Multi-Session Implementation"

' Style and theme
!theme plain
skinparam sequenceMessageAlign center
skinparam monochrome true
skinparam shadowing false

' Participants
participant "Main Task" as MT
participant "iPhone" as iPhone
participant "NXP Board" as NXPBoard
participant "Session Manager" as SM
participant "iPhone Adapter" as IA
participant "Board Adapter" as BA
participant "Resource Manager" as RM
participant "UWB Core" as UWB
participant "BLE Stack" as BLE

' System Initialization
group System Initialization
    MT -> UWB: UwbApi_Init(MultiSessionAppCallback)
    activate UWB
    UWB --> MT: UWB Stack Ready
    deactivate UWB
    
    MT -> SM: SessionManager_Init()
    activate SM
    SM -> RM: ResourceManager_Init()
    activate RM
    RM --> SM: Resources Ready (but not allocated)
    deactivate RM
    SM --> MT: Session Manager Ready
    deactivate SM
    
    MT -> BLE: BleApp_Init()
    BLE --> MT: BLE Ready
end

' iPhone Connection
group iPhone Session Establishment
    iPhone -> BLE: BLE Advertisement
    BLE -> IA: Connection Request
    activate IA
    IA -> SM: SessionManager_CreateSession(DEVICE_TYPE_IPHONE)
    activate SM
    SM --> IA: Session Created (slot 0)
    deactivate SM
    
    IA -> SM: SessionManager_StartSession()
    activate SM
    SM -> UWB: UwbApi_SessionInit()
    UWB --> SM: Session Handle
    SM -> RM: ResourceManager_AllocateChannel()
    activate RM
    RM --> SM: Channel 5 (iPhone Preferred)
    deactivate RM
    SM -> RM: ResourceManager_AllocateTimeSlot()
    activate RM
    RM --> SM: Time Slot Allocated
    deactivate RM
    SM --> IA: Session Started
    deactivate SM
    IA --> iPhone: Connection Established
    deactivate IA
end

' Board Discovery and Connection
group Board Session Establishment
    MT -> BA: BoardAdapter_StartDiscovery()
    activate BA
    NXPBoard -> BA: Discovery Response
    BA -> SM: SessionManager_CreateSession(DEVICE_TYPE_BOARD)
    activate SM
    SM --> BA: Session Created (slot 1-4)
    deactivate SM
    
    BA -> SM: SessionManager_StartSession()
    activate SM
    SM -> UWB: UwbApi_SessionInit()
    UWB --> SM: Session Handle
    SM -> RM: ResourceManager_AllocateChannel()
    activate RM
    RM -> RM: Check Channel Availability
    RM --> SM: Channel 6/8 (Board Channel)
    deactivate RM
    SM -> RM: ResourceManager_AllocateTimeSlot()
    activate RM
    RM --> SM: Time Slot Allocated
    deactivate RM
    SM --> BA: Session Started
    deactivate SM
    BA --> NXPBoard: Connection Established
    deactivate BA
end

' Ranging Operations
group Multi-Session Ranging
    loop Continuous Operation
        ' Process Events
        MT -> SM: SessionManager_ProcessEvents()
        activate SM
        SM -> RM: Check Resource Status
        RM --> SM: Resource Status
        SM --> MT: Events Processed
        deactivate SM
        
        ' Board Discovery Events
        MT -> BA: BoardAdapter_ProcessDiscoveryEvents()
        activate BA
        BA -> SM: Update Session States
        BA --> MT: Discovery Events Processed
        deactivate BA
        
        ' Resource Optimization
        MT -> RM: ResourceManager_OptimizeResourceAllocation()
        activate RM
        RM -> RM: Rebalance Resources
        RM --> MT: Resources Optimized
        deactivate RM
    end
end

' Error Recovery
group Error Recovery (Distributed)
    UWB -> MT: Error Notification
    MT -> SM: SessionManager_HandleSessionError()
    activate SM
    SM -> RM: Release Resources
    SM -> BA: Notify Error
    SM -> IA: Notify Error
    
    alt Recovery Possible
        SM -> UWB: Reset Session
        UWB --> SM: Session Reset
        SM -> RM: Reallocate Resources
        RM --> SM: Resources Reallocated
    else Recovery Failed
        SM -> MT: Session Terminated
        MT -> BA: Stop Discovery
        MT -> IA: Stop Advertising
    end
    deactivate SM
end

@enduml